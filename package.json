{
  "name": "solo-travel-genie",
  "version": "1.0.0",
  "description": "Local free-tier Firebase Genkit application in TypeScript for solo travel planning from Pune with tools and safety insights",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "genkit:dev": "genkit start -- tsx --watch src/index.ts",
    "genkit:start": "genkit start -- tsx --watch src/index.ts",
    "test:cli": "tsx src/test-cli.ts"
  },
  "keywords": [
    "genkit",
    "firebase",
    "gemini",
    "solo-travel",
    "typescript"
  ],
  "author": "SoloTravelGenie",
  "license": "MIT",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.43.0",
    "@genkit-ai/googleai": "^1.28.0",
    "dotenv": "^18.0.9",
    "genkit": "^1.43.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "genkit-cli": "^1.44.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
